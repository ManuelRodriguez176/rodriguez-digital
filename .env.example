# Copia estas variables en Vercel → Settings → Environment Variables
# (NUNCA subas los valores reales a GitHub)

# Token de acceso del usuario del sistema (Meta Business → Usuarios del sistema)
WHATSAPP_TOKEN=
# ID del número de teléfono (WhatsApp → Configuración de la API)
WHATSAPP_PHONE_NUMBER_ID=
# Una palabra secreta que inventas tú; la misma va en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app (Meta → Configuración de la app → Básica)
WHATSAPP_APP_SECRET=
# Tu WhatsApp personal, donde te llegan los avisos (507 + número, sin +)
OWNER_WHATSAPP=50763284986
# Opcional: plantilla aprobada para avisarte fuera de las 24 h
OWNER_TEMPLATE=
OWNER_TEMPLATE_LANG=es
# Opcional
GRAPH_VERSION=v23.0
